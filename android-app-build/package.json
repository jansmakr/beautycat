{
  "name": "beautycat-android-app",
  "version": "1.0.0",
  "description": "BeautyCat Android App Builder",
  "main": "build.js",
  "scripts": {
    "build": "node build.js",
    "build:debug": "bubblewrap build",
    "build:release": "bubblewrap build --skipPwaValidation",
    "init": "bubblewrap init --manifest https://beautycat.kr/manifest.json",
    "update": "bubblewrap update",
    "validate": "bubblewrap validate --url https://beautycat.kr",
    "generate-icons": "node generate-icons.js",
    "generate-screenshots": "node generate-screenshots.js",
    "create-keystore": "keytool -genkey -v -keystore android.keystore -alias android -keyalg RSA -keysize 2048 -validity 10000",
    "install-debug": "adb install app-debug.apk",
    "clean": "./gradlew clean"
  },
  "keywords": [
    "android",
    "pwa",
    "twa",
    "beautycat",
    "mobile-app"
  ],
  "author": "BeautyCat Team",
  "license": "MIT",
  "dependencies": {
    "@bubblewrap/cli": "^1.19.0",
    "sharp": "^0.32.6",
    "puppeteer": "^21.1.1",
    "jimp": "^0.22.10"
  },
  "devDependencies": {
    "eslint": "^8.48.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/beautycat/android-app"
  },
  "bugs": {
    "url": "https://github.com/beautycat/android-app/issues"
  },
  "homepage": "https://beautycat.kr"
}